generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Intended persistence for Task. Unit tests use InMemoryTaskRepository;
/// wire PrismaTaskRepository when DATABASE_URL is available.
model Task {
  id        String   @id @default(uuid())
  title     String
  createdAt DateTime @default(now())
}
